{
  "$defs": {
    "KernelPosition": {
      "additionalProperties": false,
      "properties": {
        "col": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Col",
          "type": "integer"
        },
        "elevation_ft": {
          "default": 0,
          "maximum": 10000,
          "minimum": -10000,
          "title": "Elevation Ft",
          "type": "integer"
        },
        "row": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Row",
          "type": "integer"
        }
      },
      "required": [
        "row",
        "col"
      ],
      "title": "KernelPosition",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "combat_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Combat Id"
    },
    "destination": {
      "anyOf": [
        {
          "$ref": "#/$defs/KernelPosition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entity_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Entity Ids",
      "type": "array"
    },
    "maximum_distance_ft": {
      "anyOf": [
        {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Distance Ft"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/KernelPosition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "query_kind": {
      "enum": [
        "entity_position",
        "entities_in_range",
        "visible_entities",
        "unoccupied_space",
        "cover",
        "distance",
        "path",
        "area_targets"
      ],
      "title": "Query Kind",
      "type": "string"
    },
    "scene_id": {
      "title": "Scene Id",
      "type": "string"
    },
    "schema_version": {
      "const": "scene-query-1",
      "default": "scene-query-1",
      "title": "Schema Version",
      "type": "string"
    },
    "shape": {
      "anyOf": [
        {
          "enum": [
            "point",
            "cone",
            "line",
            "cube",
            "sphere",
            "cylinder"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shape"
    },
    "size_ft": {
      "anyOf": [
        {
          "maximum": 10000,
          "minimum": 5,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size Ft"
    }
  },
  "required": [
    "query_id",
    "scene_id",
    "query_kind"
  ],
  "title": "SceneQuery",
  "type": "object"
}
