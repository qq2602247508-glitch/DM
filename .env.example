# Application
DND_DM_ENVIRONMENT=development
DND_DM_API_PREFIX=/api/v1
DND_DM_HOST=127.0.0.1
DND_DM_PORT=8000
DND_DM_FRONTEND_ORIGIN=http://127.0.0.1:5173
DND_DM_DATABASE_URL=sqlite:///./data/dnd_dm.db
DND_DM_VECTOR_STORE_PATH=./data/vectors

# Local model runtime. Model identifiers are deliberately supplied by config.
DND_DM_OLLAMA_BASE_URL=http://127.0.0.1:11434
DND_DM_INTENT_MODEL=
# This is the locally verified example on this Mac; set any installed local model.
DND_DM_REASONING_MODEL=qwen3:30b-instruct
DND_DM_EMBEDDING_MODEL=bge-m3:latest
DND_DM_OLLAMA_EMBEDDING_TIMEOUT_SECONDS=120
DND_DM_OLLAMA_GENERATION_TIMEOUT_SECONDS=300
DND_DM_OLLAMA_INTENT_TIMEOUT_SECONDS=120
DND_DM_OLLAMA_RETRIES=2

# Local RAG. Vector dimensions are discovered from the first embedding batch.
DND_DM_RAG_COLLECTION_NAME=dnd_rules
DND_DM_RAG_CORPUS_JSON_ROOT=./data/generated-content/dnd5e_chm/json
DND_DM_RAG_MANIFEST_PATH=./data/vectors/dnd_rules-manifest.json
DND_DM_RAG_CHUNK_MAX_CHARS=1800
DND_DM_RAG_CHUNK_OVERLAP_CHARS=180
DND_DM_RAG_EMBEDDING_BATCH_SIZE=32
DND_DM_RAG_INDEX_BATCH_RECORDS=24
DND_DM_RAG_SEARCH_TOP_K=6
DND_DM_RAG_SEARCH_CANDIDATE_K=18
DND_DM_RAG_SEARCH_MIN_SCORE=0.45
DND_DM_RAG_MAX_EVIDENCE_CHARS=12000

# Local-only content ingestion. Defaults are intentionally slow and bounded.
DND_DM_CONTENT_BASE_URL=https://5echm.kagangtuya.top/
DND_DM_CONTENT_ALLOWED_HOSTS=5echm.kagangtuya.top
DND_DM_CONTENT_GENERATED_ROOT=./data/generated-content
DND_DM_CONTENT_CHECKOUT_ROOT=./data/sources
DND_DM_CONTENT_USER_AGENT=LocalDnDDMAssistant/0.1 (+local research; contact: unset)
DND_DM_CONTENT_CONNECT_TIMEOUT_SECONDS=10
DND_DM_CONTENT_READ_TIMEOUT_SECONDS=20
DND_DM_CONTENT_MAX_RESPONSE_BYTES=2097152
DND_DM_CONTENT_DELAY_SECONDS=1
DND_DM_CONTENT_RETRIES=2
DND_DM_CONTENT_BACKOFF_SECONDS=1
DND_DM_CONTENT_CONCURRENCY=1
DND_DM_CONTENT_MAX_PAGES=20

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
